{
  "name": "tokusai-ag",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SVSS 経理AG パイロット: 請求書の督促エージェント（Mastra スターター）",
  "scripts": {
    "dev": "mastra dev",
    "start": "tsx --env-file-if-exists=.env src/run.ts",
    "reinstruct": "tsx --env-file-if-exists=.env src/reinstruct.ts",
    "build": "mastra build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "@mastra/core": "^1.63.0",
    "@notionhq/client": "^2.2.15",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "mastra": "^1.27.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
